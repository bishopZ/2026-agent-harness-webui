{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "outDir": "dist/server",
    "rootDir": "src/server"
  },
  "include": ["src/server", "vite.config.ts"],
  "exclude": ["node_modules", "dist"]
}
