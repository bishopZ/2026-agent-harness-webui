{
  "name": "2026-agent-harness-webui",
  "version": "0.1.0",
  "description": "Local browser shell for the 2026 Agent Harness: doc reader + priority workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/server/index.ts",
    "build": "tsc -p tsconfig.node.json && vite build",
    "preview": "NODE_ENV=production tsx src/server/index.ts",
    "start": "NODE_ENV=production node dist/server/index.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^5.0.1",
    "marked": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.28.0",
    "write-file-atomic": "^6.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/write-file-atomic": "^4.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
