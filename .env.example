# Required: absolute path to the Agent Harness Web UI repo root (this folder).
# Must contain SYSTEM_OVERVIEW.md, initiatives/, and priorities.json.
# Example:
#   HARNESS_ROOT=/Users/yourname/cowork/
HARNESS_ROOT=

# priorities.json is always: ${HARNESS_ROOT}/priorities.json
# (not configurable separately; see src/server/paths.ts)

# Optional: port to bind on (default: 3747)
PORT=3747
