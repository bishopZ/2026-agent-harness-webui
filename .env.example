# Required: absolute path to the root of your agent harness folder.
# This folder must contain SYSTEM_OVERVIEW.md and an initiatives/ subdirectory.
# Example (point to your local clone of 2026-agent-harness):
#   HARNESS_ROOT=/Users/yourname/projects/2026-agent-harness
# Or point to the demo harness bundled in this repo:
#   HARNESS_ROOT=/absolute/path/to/2026-agent-harness-webui
HARNESS_ROOT=

# Optional: port to bind on (default: 3747)
PORT=3747
